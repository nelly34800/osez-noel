# Étape 1 : builder Node.js pour installer Bootstrap
FROM node:20-alpine AS builder

# Définir le dossier de travail
WORKDIR /app

# Copier uniquement les fichiers de dépendances (package.json et package-lock.json)
COPY frontend/package*.json ./

# Installer toutes les dépendances (Bootstrap inclus)
RUN npm install

# Copier le reste du front (HTML, CSS, JS)
COPY ./frontend /app/frontend

# Étape 2 : conteneur Nginx léger pour servir le front
FROM nginx:alpine

# Copier ton frontend existant dans Nginx
COPY ./frontend/public /usr/share/nginx/html

# Copier la config Nginx (avec try_files pour router JS)
COPY ./config/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copier les dépendances npm nécessaires (Bootstrap CSS/JS)
COPY --from=builder /app/node_modules /usr/share/nginx/html/node_modules

# Exposer le port 80
EXPOSE 80

# Lancer Nginx
CMD ["nginx", "-g", "daemon off;"]
